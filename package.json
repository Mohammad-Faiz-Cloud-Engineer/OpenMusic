{
  "name": "openmusic",
  "version": "0.1.4",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --ci",
    "test:build": "jest __tests__/build --ci",
    "typecheck": "tsc --noEmit",
    "audit:prod": "npm audit --omit=dev",
    "build:check": "node scripts/build-check.js",
    "ci": "npm run typecheck && npm test -- --ci && npm run build:check && npm run audit:prod"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/native": "^7.2.4",
    "@react-navigation/stack": "^7.10.6",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "expo": "~56.0.0",
    "expo-av": "^16.0.8",
    "expo-blur": "~56.0.3",
    "expo-font": "~56.0.7",
    "expo-linear-gradient": "~56.0.4",
    "expo-localization": "~56.0.6",
    "expo-status-bar": "~56.0.4",
    "i18next": "^26.3.3",
    "react": "19.2.7",
    "react-i18next": "^17.0.8",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~3.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.3",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~56.0.0",
    "jest": "^30.4.2",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "19.2.7",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": ["typescript"]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": ["expo-av"]
      }
    }
  },
  "overrides": {
    "js-yaml": "4.2.0",
    "@tootallnate/once": ">=3.0.1",
    "postcss": ">=8.5.10",
    "glob": "^13.0.0",
    "rimraf": "^6.0.1",
    "uuid": "^11.1.0",
    "jsdom": "^28.1.0",
    "test-exclude": "^8.0.0",
    "babel-plugin-istanbul": "^8.0.2"
  },
  "private": true
}
